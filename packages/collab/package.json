{
  "name": "system-canvas-collab",
  "version": "0.2.57",
  "description": "Yjs-backed multi-user collaboration for system-canvas. Binds a Y.Doc to the renderer's controlled props so any consumer gets conflict-free multiplayer by supplying only a transport.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stakwork/system-canvas.git",
    "directory": "packages/collab"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "system-canvas",
    "yjs",
    "crdt",
    "collaboration",
    "multiplayer"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "system-canvas": "^0.2.57",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^19.0.0",
    "system-canvas": "^0.2.57",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7",
    "yjs": "^13.6.0"
  }
}
